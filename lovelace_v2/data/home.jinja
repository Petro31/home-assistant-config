{#-
  The house: a Room Summary Card on Home, atop the Household window (square,
  half width, beside the remote's), shaped like an area (same keys; area_id is not a real HA area, the
  card doesn't need one). Its lights and leaks count every area's. 'icons'
  lists the keys shown as small icons, in order; every icon opens more-info
  (never toggles the house), or, for a key in 'links', the page of that Home
  button (by name). The card opens Areas. 'image' is the card's background
  (the Areas button's picture). Its locks group (the lock plus every door) is
  added after the doors list below. After the four counted icons, 'extras':
  the Echos (Amazon logo), opening the Echos view; main.yaml pins it to the
  bottom of a second column.
-#}
{%- set house_ns = namespace(lights=[], leaks=[]) %}
{%- for area in areas %}
  {%- for key in ['lights', 'leaks'] if key in area %}
    {%- for g in ([area[key]] if area[key] is mapping else area[key]) %}
      {%- for e in g.entities | default([g.target]) %}
        {%- if key == 'lights' and e not in house_ns.lights %}{%- set house_ns.lights = house_ns.lights + [e] %}
        {%- elif key == 'leaks' and e not in house_ns.leaks %}{%- set house_ns.leaks = house_ns.leaks + [e] %}{%- endif %}
      {%- endfor %}
    {%- endfor %}
  {%- endfor %}
{%- endfor %}
{%- set house = {
  'name': 'Home',
  'area_id': 'home',
  'icon': 'mdi:home',
  'image': '/local/images/home_transparent_5.png',
  'icons': ['lights', 'locks', 'appliances', 'leaks'],
  'toggle': [],
  'links': {'lights': 'Areas', 'locks': 'Doors', 'appliances': 'Laundry'},
  'lights': {'target': 'light.floor_all', 'entities': house_ns.lights},
  'appliances': {
    'target': 'binary_sensor.laundry_running',
    'entities': ['binary_sensor.washer', 'binary_sensor.dryer_status'],
  },
  'leaks': {'target': 'binary_sensor.leak', 'entities': house_ns.leaks},
  'extras': [
    {'entity_id': 'sensor.alexa_last_tts', 'icon': 'fab:amazon', 'link': 'Echos', 'color': 'amber'},
