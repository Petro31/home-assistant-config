{#-
  Data for the Home v2 dashboard (ui-home-v2.yaml).

  This is not a YAML file. The lovelace_v2 views import from it:
    {% from '/config/lovelace_v2/data/home.jinja' import main_buttons, people %}

  Count groups. Areas and main buttons list what they count under these keys
  (lights, fans, doors, locks, appliances, leaks, media). A group is
    {'target': entity_id, 'entities': [entity_ids]}
  'target' is the entity shown for the group (the room card's icon, the
  subview's first tile); 'entities' are what's counted, i.e. how many are in
  one of the rule's states. Either may be left out: 'entities' defaults to
  [target], 'target' to the first of 'entities'. A key may also hold a list of
  groups, one icon each (e.g. Garage's car bay doors and passenger door).
  Room cards only: 'state' replaces the rule's states for the icon's count,
  and 'badge_entity' shows the count while that entity is on (instead of
  while the target is in one of the states).

  Count rules, in the order of the counts in status lines ("3 lights on ·
  1 fan on") and badges (top of the Areas, area and Doors views; hidden while
  0). 'unit'/'units' are the singular/plural words; 'color' (badges) defaults
  to amber. 'icon' marks the groups shown as room card icons (leaks and media
  aren't).
-#}
{%- set count_rules = [
  {'key': 'lights', 'state': ['on'], 'icon': 'mdi:lightbulb-multiple', 'unit': 'light on', 'units': 'lights on', 'room_icon': true},
  {'key': 'fans', 'state': ['on'], 'icon': 'mdi:fan', 'unit': 'fan on', 'units': 'fans on', 'room_icon': true},
  {'key': 'doors', 'state': ['on', 'open', 'opening'], 'icon': 'mdi:door-open', 'unit': 'door open', 'units': 'doors open', 'color': 'red', 'room_icon': true},
  {'key': 'locks', 'state': ['unlocked', 'unlocking', 'open', 'opening'], 'icon': 'mdi:lock-open', 'unit': 'lock unlocked', 'units': 'locks unlocked', 'color': 'red', 'room_icon': true},
  {'key': 'appliances', 'state': ['on'], 'icon': 'mdi:washing-machine', 'unit': 'appliance running', 'units': 'appliances running', 'color': 'blue', 'room_icon': true},
  {'key': 'leaks', 'state': ['on'], 'icon': 'mdi:water', 'unit': 'leak', 'units': 'leaks', 'color': 'blue'},
  {'key': 'media', 'state': ['on', 'playing', 'idle', 'paused'], 'icon': 'mdi:speaker-wireless', 'unit': 'zone on', 'units': 'zones on'},
] %}

{#- An item's groups under one key, filled in: JSON [{'target', 'entities'}]. #}
{%- macro groups(item, key) %}
  {%- set ns = namespace(out=[]) %}
  {%- set value = item[key] if key in item else [] %}
  {%- for g in ([value] if value is mapping else value) %}
    {%- set ids = g.entities if 'entities' in g else ([g.target] if 'target' in g else []) %}
    {%- if ids or 'target' in g %}
      {%- set one = namespace(g={'target': g.target if 'target' in g else ids[0], 'entities': ids}) %}
      {%- for k in ['state', 'badge_entity'] if k in g %}
        {%- set one.g = dict(one.g, **{k: g[k]}) %}
      {%- endfor %}
      {%- set ns.out = ns.out + [one.g] %}
    {%- endif %}
  {%- endfor %}
  {{- ns.out | tojson }}
{%- endmacro %}

